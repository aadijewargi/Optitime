{
  "manifest_version": 3,
  "name": "OptiTime",
  "version": "1.1.0",
  "description": "Set daily time limits for distracting websites and keep a to-do list. OptiTime blocks the sites when your time is up.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "OptiTime",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage", "alarms", "tabs", "idle", "declarativeNetRequest"],
  "host_permissions": ["<all_urls>"]
}
